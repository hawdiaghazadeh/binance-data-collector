# Copy to .env — activates full pipeline on `docker compose up`
COMPOSE_PROFILES=full,grafana

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

GRAFANA_PORT=3080
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# RL training (rl-train service)
# smoke.yaml = synthetic data | clickhouse.yaml = real imported klines
TRAIN_CONFIG=/config/training/smoke.yaml
TRAIN_STEPS=128
